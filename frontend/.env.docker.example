# Copy to .env.docker; use: docker compose --env-file .env.docker up -d --build
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=5173
HRM_DOCKER_NETWORK=hrm-services
IMAGE_REPOSITORY=company-hrm/frontend
IMAGE_TAG=local
# Runtime proxy URL; no rebuild needed when it changes. Do not append /api.
API_GATEWAY_URL=http://gateway:8080
