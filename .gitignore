logs/

# Local environment configuration; keep documented templates
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Backend runtime JWT keys (test fixtures remain tracked)
/back-end/**/keys/

# Local Java upgrade assistant output; retain other GitHub configuration
**/.github/modernize/

# Keep dependency lockfiles, Maven wrappers, source code and SQL scripts tracked.
