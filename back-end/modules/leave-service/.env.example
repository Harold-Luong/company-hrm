# Local template. Copy to .env if missing and configure this project's database/keys/URLs.
# Keep existing .env values; see README.md for setup. Do not commit .env.
# Local development: run from this module directory.
# Provide a copy of the issuer access public key at ./keys/access-public.pem.
# Provision the same public key separately for each deployment; private keys stay with Auth.
# Git Bash: set -a; source ./.env; set +a; mvn spring-boot:run
SERVER_PORT='8084'
SERVER_ADDRESS='127.0.0.1'
JWT_ACCESS_PUBLIC_KEY='file:./keys/access-public.pem'
JWT_ACCESS_ISSUER='auth-service'
JWT_ACCESS_AUDIENCE='hrm-api-access'
SPRING_DATASOURCE_URL='jdbc:postgresql://127.0.0.1:55432/leave_db'
SPRING_DATASOURCE_USERNAME='leave_user'
SPRING_DATASOURCE_PASSWORD='replace_with_local_database_password'
KAFKA_BOOTSTRAP_SERVERS='127.0.0.1:9092'
HRM_NOTIFICATIONS_ENABLED='true'
