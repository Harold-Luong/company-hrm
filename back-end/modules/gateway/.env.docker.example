# Copy to .env.docker; use: docker compose --env-file .env.docker up -d --build
# This file is separate from .env used by native Maven/IDE runs.
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
HRM_DOCKER_NETWORK=hrm-services
IMAGE_REPOSITORY=company-hrm/gateway
IMAGE_TAG=local
# The runtime UID/GID must be able to read the mounted key files.
APP_UID=10001
APP_GID=10001
JWT_ACCESS_PUBLIC_KEY_FILE=./keys/access-public.pem
JWT_ACCESS_ISSUER=auth-service
JWT_ACCESS_AUDIENCE=hrm-api-access
AUTH_SERVICE_URL=http://auth:8081
EMPLOYEE_SERVICE_URL=http://employee:8082
WORKFORCE_SERVICE_URL=http://calendar:8083
LEAVE_SERVICE_URL=http://leave:8084
ATTENDANCE_SERVICE_URL=http://attendance:8085
NOTIFICATION_SERVICE_URL=http://notification:8086
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
