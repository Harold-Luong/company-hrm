# Copy to .env and replace the passwords and absolute file paths.
GATEWAY_HTTPS_PORT=443
CORS_ALLOWED_ORIGINS=https://hrm.example.com
AUTH_DB_PASSWORD=replace-with-a-long-unique-password
EMPLOYEE_DB_PASSWORD=replace-with-another-long-unique-password
WORKFORCE_DB_PASSWORD=replace-with-another-long-unique-password
LEAVE_DB_PASSWORD=replace-with-a-separate-long-unique-password
TLS_KEY_STORE_PASSWORD=replace-with-keystore-password
TLS_KEY_STORE_FILE=/absolute/path/to/gateway.p12
JWT_ACCESS_PUBLIC_KEY_FILE=/absolute/path/to/access-public.pem
JWT_ACCESS_PRIVATE_KEY_FILE=/absolute/path/to/access-private.pem
JWT_REFRESH_PUBLIC_KEY_FILE=/absolute/path/to/refresh-public.pem
JWT_REFRESH_PRIVATE_KEY_FILE=/absolute/path/to/refresh-private.pem
