# Copy to .env.docker; use: docker compose --env-file .env.docker up -d --build
# This file is separate from .env used by native Maven/IDE runs.
HOST_BIND_ADDRESS=127.0.0.1
HOST_PORT=8085
HRM_DOCKER_NETWORK=hrm-services
IMAGE_REPOSITORY=company-hrm/attendance
IMAGE_TAG=local
# The runtime UID/GID must be able to read the mounted key files.
APP_UID=10001
APP_GID=10001
JWT_ACCESS_PUBLIC_KEY_FILE=./keys/access-public.pem
JWT_ACCESS_ISSUER=auth-service
JWT_ACCESS_AUDIENCE=hrm-api-access
# Point to an already prepared database reachable from the container.
# host.docker.internal reaches the Docker host, not this container's localhost.
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:55432/attendance_db
SPRING_DATASOURCE_USERNAME=attendance_user
SPRING_DATASOURCE_PASSWORD=replace_with_database_password
SPRING_SQL_INIT_MODE=never
SPRING_JPA_SHOW_SQL=false
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
HRM_NOTIFICATIONS_ENABLED=false
AUTH_SERVICE_URL=http://auth:8081
EMPLOYEE_SERVICE_URL=http://employee:8082
LEAVE_SERVICE_URL=http://leave:8084
CALENDAR_SERVICE_URL=http://calendar:8083
# Configure real company networks and trusted Gateway IPs for check-in/out.
# Loopback defaults intentionally do not allow arbitrary Docker clients.
ATTENDANCE_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
ATTENDANCE_TRUSTED_PROXIES=127.0.0.1/32,::1/128
