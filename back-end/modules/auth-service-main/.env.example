# Spring Boot does not automatically load this file. Copy to .env and export it
# in the shell (see README.md#activation), or set these in your IDE.
HRM_EVENTS_ENABLED=true
AUTH_ACTIVATION_ENABLED=true
# Replace xxxx with your Resend API key before enabling activation.
RESEND_API_KEY=re_your_api_key
# Use an address on a domain verified in your Resend account.
RESEND_FROM='Company HRM <onboarding@resend.dev>'
AUTH_ACTIVATION_FRONTEND_URL=http://localhost:8080/activate
AUTH_ACTIVATION_TOKEN_TTL=1h
# Generate once with: openssl rand -base64 32
# Keep this secret stable across restarts and identical on all Auth replicas.
AUTH_ACTIVATION_TOKEN_SECRET=replace_with_base64_secret

# Local template. Copy to .env if missing and configure this project's database/keys/URLs.
# Keep existing .env values; see README.md for setup. Do not commit .env.
# Local development: run from this module directory.
# Git Bash: set -a; source ./.env; set +a; mvn spring-boot:run
SERVER_PORT='8081'
SERVER_ADDRESS='127.0.0.1'
JWT_ACCESS_PUBLIC_KEY='file:../../../.cache/local/keys/access-public.pem'
JWT_ACCESS_ISSUER='auth-service'
JWT_ACCESS_AUDIENCE='hrm-api-access'
SPRING_DATASOURCE_URL='jdbc:postgresql://127.0.0.1:55432/auth_db'
SPRING_DATASOURCE_USERNAME='auth_user'
SPRING_DATASOURCE_PASSWORD='replace_with_local_database_password'
KAFKA_BOOTSTRAP_SERVERS='127.0.0.1:9092'
JWT_ACCESS_PRIVATE_KEY='file:../../../.cache/local/keys/access-private.pem'
JWT_REFRESH_PRIVATE_KEY='file:../../../.cache/local/keys/refresh-private.pem'
JWT_REFRESH_PUBLIC_KEY='file:../../../.cache/local/keys/refresh-public.pem'
