# Optional overrides for the LOCAL stack in compose.yaml. See DOCKER.md.
FRONTEND_PORT=5173
GATEWAY_PORT=8080
AUTH_DB_PASSWORD=auth_local_password
EMPLOYEE_DB_PASSWORD=employee_local_password
CALENDAR_DB_PASSWORD=calendar_local_password
LEAVE_DB_PASSWORD=leave_local_password
ATTENDANCE_DB_PASSWORD=attendance_local_password

# Local demo: gateway sees the Nginx container, not the browser's real IP.
# An empty value disables check-in/out. Do not use this allowlist for production.
ATTENDANCE_ALLOWED_NETWORKS=172.30.80.10/32

# Optional activation email (requires a valid provider account and sender).
AUTH_ACTIVATION_ENABLED=false
AUTH_ACTIVATION_TOKEN_SECRET=
RESEND_FROM=
RESEND_API_KEY=
